# Vigilantis MVP 환경변수 예시 — 복사해서 .env 로 사용 (cp .env.example .env)
# 실제 .env 는 커밋 금지 (.gitignore 처리됨)

# ── Database (PostgreSQL) ─────────────────────────
POSTGRES_USER=vigilantis
POSTGRES_PASSWORD=vigilantis
POSTGRES_DB=vigilantis
# db 서비스의 호스트 노출 포트. 로컬에 PostgreSQL이 설치돼 5432가 충돌할 때만 변경한다.
# 호스트에서 도는 pytest도 이 값을 읽으므로(apps/core-api/**/tests/conftest.py) 여기만 고치면 된다.
POSTGRES_PORT=5432
# 컨테이너 내부 접속 문자열 — compose 네트워크 안에서는 항상 db:5432라 POSTGRES_PORT와 무관하다.
DATABASE_URL=postgresql+psycopg://vigilantis:vigilantis@db:5432/vigilantis

# ── App ───────────────────────────────────────────
APP_PORT=8000
# Core API 로깅 레벨·CORS 허용 출처(콤마 구분) — 기본값과 다르게 쓸 때만 주석 해제
#LOG_LEVEL=INFO
#CORS_ALLOW_ORIGINS=http://localhost:3000
# 작동 로그 파일 출력(#424) — Settings 기본은 stdout만이지만 compose api는 기본 켠다(끄려면 false).
# 켜면 apps/core-api 기준 경로의 회전 파일(10 MiB × (현재 + 백업 20개), 압축 없음)에도 쓴다.
# 그 폴더는 compose가 호스트와 공유하므로 api 컨테이너를 다시 만들어도 남는다.
# stepper 테스트 서버는 override가 경로를 .logs/stepper/api.log로 바꿔 이 파일과 섞이지 않는다
#LOG_FILE_ENABLED=true
#LOG_FILE_PATH=.logs/api.log
#LOG_FILE_BACKUP_COUNT=20
# API 문서(/docs · /redoc · /openapi.json, #492) — Settings 기본은 꺼짐(셋 다 404). 로컬 개발에서만 켠다.
# 배포(scripts/provision_platform_aws.py)는 태스크에 넘길 환경변수를 명시 목록으로 넘기므로 이 값이 따라가지 않아 꺼진 채로 뜬다.
API_DOCS_ENABLED=true

# ── 모의 위협 입력 (#322) ─────────────────────────
# 미설정 시 꺼짐. 호스트 직접 실행은 준비 폴더의 절대 경로를 지정한다.
# Compose는 기존 apps/core-api 마운트를 공유하므로 컨테이너 안 경로를 지정한다:
#MOCK_THREAT_INBOX_DIR=/app/apps/core-api/.mock-threat-inbox
#MOCK_THREAT_POLL_SECONDS=1
# ── 외부 알림 (#493 PR2) ──────────────────────────
# 기본 비활성. routes 파일과 public URL까지 명시한 운영 배포에서만 켠다.
NOTIFICATION_ENABLED=false
#NOTIFICATION_ROUTES_FILE=/run/config/notification-routes.json
#NOTIFICATION_PUBLIC_BASE_URL=https://dashboard.example.com
# routes JSON 예시(비밀값 없음):
# {"routes":[{"tenant_id":"11111111-1111-4111-8111-111111111111","aws_account_id":"111111111111","slack_webhook_env":"NOTIFICATION_SLACK_A","sns_topic_arn":"arn:aws:sns:ap-northeast-2:999999999999:customer-a"}]}
# tenant_id는 형식 예시다 — 대상 DB tenants 테이블에 실제로 등록된 행의 UUID로 바꾼다(추측·기본 테넌트 금지).
# aws_account_id는 그 행의 aws_account_id와 같아야 한다. 없거나 다르면 라우트를 반영하기 전에 기동이 멈춘다
# (테넌트 없음 TENANT_NOT_FOUND / 계정 불일치 TENANT_ACCOUNT_MISMATCH).
# DB의 PENDING/IN_FLIGHT 행 중 하나라도 tenants에 같은 UUID가 없거나 계정이 다르면, 설정에 남은 라우트인지와
# 관계없이 NOTIFICATION_TENANT_TRANSITION_REQUIRED로 기동이 멈춘다(행을 고치거나 종료하거나 보내지 않음).
# 세 코드는 기동 로그 notification_tenant_binding_invalid의 reason으로 남는다(테넌트 ID·수신처·원문 오류 없음).
# 기동 실패 자체는 고정 코드 NOTIFICATION_START_FAILED로 올라간다(README §외부 알림 운영).
# sns_topic_arn의 계정(999999999999)은 토픽을 소유한 플랫폼 계정이며 고객 소유 판정에 쓰지 않는다.
# Slack만/SNS만이면 다른 채널의 키를 생략한다. 환경변수 NOTIFICATION_SLACK_A에는
# 배포 비밀 주입으로 webhook을 넣는다. 파일·발송 DB·로그에는 webhook을 넣지 않는다.
# SNS는 ECS 플랫폼 태스크 자격증명만 사용한다(고객 AWS_PROFILE·정적 키 fallback 없음).
# 실제 역할·지정 토픽 Publish 권한·구독·비밀 주입·로그인 링크 검증은 PR3 몫이다.
# 운영 이미지(serve.py)는 NOTIFICATION_ENABLED=true일 때 비밀 아닌 NOTIFICATION_ROUTES_JSON을 검증한 뒤
# $HOME/.vigilantis/notification-routes.json 으로 쓰고 NOTIFICATION_ROUTES_FILE을 그 경로로 잡는다.
# JSON과 NOTIFICATION_ROUTES_FILE을 함께 주면 기동이 멈춘다. ECS 배포 값은
# scripts/provision_platform_aws.py --notification-config 가 채운다(직접 쓰지 않는다).
# Compose 개발 스택은 serve.py를 거치지 않는다: routes 파일을 apps/core-api 아래(바인드 마운트)에 두고
# NOTIFICATION_ROUTES_FILE=/app/apps/core-api/<파일>처럼 직접 가리킨다.
#NOTIFICATION_ROUTES_JSON=
# 최초 등록/연결 변경의 DB 적용 시각 이전 사건은 발송하지 않는다.
# 고객·계정·webhook·토픽이 바뀌면 기존 대기는 BLOCKED, 새 사건부터 새 연결을 쓴다.
# 차단/영구 실패/재시도 소진을 설정 변경으로 재개하지 않는다. 변경 적용에는 재기동 필요.
# Slack 게시 응답과 SNS 접수는 이메일 도착/열람 보장이 아니다. 중단 복구 시 중복 가능.
#NOTIFICATION_POLL_SECONDS=1
#NOTIFICATION_BATCH_SIZE=20
#NOTIFICATION_MAX_ATTEMPTS=5
#NOTIFICATION_BACKOFF_SECONDS=2
#NOTIFICATION_MAX_BACKOFF_SECONDS=300
#NOTIFICATION_CONNECT_TIMEOUT_SECONDS=3
#NOTIFICATION_READ_TIMEOUT_SECONDS=5
#NOTIFICATION_LEASE_SECONDS=120
# 호스트에서 S3 준비(대상 ARN은 수집된 시연 EC2로 교체):
# uv run python scripts/inject_mock_threat.py evt_ssh_bruteforce_001 --prepare-inbox apps/core-api/.mock-threat-inbox --target-arn <EC2_ARN>
# 같은 입력은 재전달, 새 관측은 --occurred-at <ISO8601>을 추가한다.
# 준비는 저장 성공이 아니다. 앱이 소비한 원문은 done/, 계약 거부는 rejected/로 이동한다.
# DB 데이터 오류는 rejected/로 보관하고, 그 밖의 저장 장애는 원문을 남겨 재시도한다.
# 결과는 GET /api/v1/incidents에서 확인한다.

# ── 고객(테넌트) 온보딩 링크 (Post-MVP T-4) ─────────
# 비어 있으면 앱은 뜨고, 온보딩 링크를 싣는 /api/v1/tenants 응답(생성 · 연결 전 상세 · PATCH · 재발급)만
# 503 TENANT_ONBOARDING_UNAVAILABLE 로 답한다. 템플릿 호스팅은 INFRA 몫이다.
#TENANT_ONBOARDING_TEMPLATE_URL=https://<버킷>.s3.amazonaws.com/vigilantis-access.yaml
#PLATFORM_PRINCIPAL_ARN=arn:aws:iam::<플랫폼 계정 ID>:role/vigilantis-platform

# ── 실행 디스패치·2/2 Status Check 판정 ────────────
# 기본값과 다르게 쓸 때만 주석 해제. 시연에서 대기를 조여야 하는 값이라 코드 상수가 아니다.
# 스캔 주기(초) — 실행·DB 대기는 별도라 발동 지연 상한이 아니다 (dispatcher.py).
#DISPATCH_INTERVAL_SECONDS=10
# Medium 승인 대기 DB 감시 주기(초). 기존 시작+60초 기한을 바꾸지 않는다.
# 주기는 발동 지연의 상한이 아니며 밀린 건도 다음 스캔에서 원래 기한으로 판정한다.
#AGENT_WAIT_POLL_SECONDS=1
# 스캔 잡 기동 스위치. false면 예약이 실행으로 넘어가지 않는다
#DISPATCH_ENABLED=true
# 수집→판정 스캔 잡 기동 스위치. false면 앱을 띄워도 파이프라인이 돌지 않는다
#SCAN_ENABLED=true
# 2/2 Status Check 대기 = Delay × MaxAttempts (기본 15×12 = 3분, #240).
# 판정 1건이 그만큼 다음 스캔을 미룬다(max_instances=1) — 짧게 잡으면 부팅 중인
# 인스턴스가 타임아웃으로 읽혀 자동 원복이 앞당겨 발동한다.
#STATUS_CHECK_WAIT_DELAY_SECONDS=15
#STATUS_CHECK_WAIT_MAX_ATTEMPTS=12
# 판정 불가 재시도 (#249) — AWS 조회 실패로 결과를 확정하지 못한 실행을 다시 물을 상한과
# 간격(초). 첫 실패도 센다. 소진하면 자동 원복하지 않고 UNVERIFIED(결과 확인 불가)로
# 확정해 관제자에게 넘긴다. 권한 거부 등 다시 물어도 같은 사유는 첫 실패에서 넘긴다.
#VERIFICATION_RETRY_MAX_ATTEMPTS=5
#VERIFICATION_RETRY_INTERVAL_SECONDS=60

# ── 개발 도구 (선택 — docker compose --profile tools) ──
# adminer(DB 웹 UI) 포트. 8080 충돌 시에만 변경(미설정 시 기본 8080)
ADMINER_PORT=8080

# ── OpenAI (gpt-5.6-luna) ─────────────────────────
OPENAI_API_KEY=sk-...
# 모델 호출 경계(apps/core-api/ai/openai_client.py) 설정 — 기본값과 다르게 쓸 때만 주석 해제
#OPENAI_MODEL=gpt-5.6-luna
# 모델 동작 노브 — 값을 넣은 것만 호출에 실린다. 모델 계열마다 받는 것이 다르다:
# gpt-4o는 temperature만, gpt-5 계열 추론 모델은 reasoning_effort만 받는다.
# 받지 않는 쪽을 켜면 호출이 400으로 거절된다(재시도 없이 즉시 실패).
#
# 기본 모델이 추론 모델이라 아래 두 줄의 기본값은 temperature 미설정 +
# reasoning_effort=low다. gpt-4o 계열로 바꿀 때는 두 노브를 함께 뒤집는다 —
# OPENAI_MODEL=gpt-4o · OPENAI_TEMPERATURE=0 · OPENAI_REASONING_EFFORT=unset.
#OPENAI_TEMPERATURE=0
# 값 집합: unset | none | minimal | low | medium | high | xhigh | max
# unset만 SDK 값이 아니라 "이 노브를 싣지 말라"는 표기다(none은 모델에 보내는 값이라
# 끄기로 못 쓴다). 기본값이 low라 끄려면 이 표기가 필요하다.
# 실제로 받는 값은 모델마다 다르다 — 계측한 gpt-5.6-luna·terra·gpt-5.4-nano는
# none·low·medium·high·xhigh만 받고 minimal·max는 400으로 거절했다(#237).
#OPENAI_REASONING_EFFORT=low
#OPENAI_TIMEOUT_SECONDS=30
# 재시도는 일시 오류만 대상. 1이면 재시도 없음
#OPENAI_MAX_ATTEMPTS=3
#OPENAI_RETRY_BACKOFF_SECONDS=1
# 서버가 Retry-After로 더 길게 지시하면 따르지 않고 backoff로 간다
#OPENAI_MAX_RETRY_AFTER_SECONDS=60

# ── AWS (단일 계정 / 1~2개 리전, MVP) ─────────────
# 개발 표준 = LocalStack (ADR-0006). 더미 자격증명(test)이면 충분하다.
# 실 AWS 전환(9주차 스모크 10/6(화)–10/8(목) 첫날): 앱 전용 키(vigilantis-smoke-app)로 교체 + AWS_ENDPOINT_URL 줄 삭제.
# 관리자 키는 여기에 넣지 않는다 — 앱은 최소 권한 키로만 돈다(ADR-0009 §2).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-2
# 복수 리전 수집 시 콤마 구분 (미설정 시 AWS_REGION 사용)
#AWS_REGIONS=ap-northeast-2,us-east-1
# LocalStack 전환 스위치 — 설정 시 LocalStack, 미설정 시 실 AWS (ADR-0006 §3: 이 변수 하나로만 전환)
# 값은 compose 내부(api 컨테이너) 기준. 호스트에서 직접 실행(pytest·시드 스크립트)할 땐 http://localhost:4566 사용.
AWS_ENDPOINT_URL=http://localstack:4566
# localstack 서비스의 호스트 노출 포트 — 기본 4566. 워크트리별 스택을 동시에 띄워 4566이 충돌할 때만 변경한다.
# 바꾸면 호스트에서 도는 시드·pytest의 AWS_ENDPOINT_URL(http://localhost:<이 값>)도 셸에서 함께 맞춘다
# (POSTGRES_PORT와 달리 AWS 설정은 .env를 읽지 않는다).
#LOCALSTACK_PORT=4566

# ── 로그인 · Cognito (#492) ───────────────────────
# 네 값(REGION·USER_POOL_ID·CLIENT_ID·CLIENT_SECRET) 중 하나라도 비면 앱은 뜨지만 /api/v1/auth/* 는 503(AUTH_PROVIDER_UNAVAILABLE).
# Cognito 호출은 AWS_ENDPOINT_URL(LocalStack)을 무시하고 항상 실 AWS 엔드포인트로 간다.
#COGNITO_REGION=ap-northeast-2
#COGNITO_USER_POOL_ID=
#COGNITO_CLIENT_ID=
#COGNITO_CLIENT_SECRET=
# 로컬 개발에서 이름 있는 AWS 프로파일로 Cognito에 붙을 때만 — 위 LocalStack 더미 키가 쓰이지 않게 한다. 배포는 비운다(태스크 역할).
#COGNITO_AWS_PROFILE=
# 세션 최대 수명(초, 8시간) / 유휴 한도(초, 30분) / 한 로그인에서 코드 제출 허용 횟수
#AUTH_SESSION_MAX_SECONDS=28800
#AUTH_SESSION_IDLE_SECONDS=1800
#AUTH_TOTP_MAX_ATTEMPTS=3
# 로그인 흐름을 가로지르는 코드 실패 한도(회) / 집계 윈도(초, 15분)
#AUTH_CODE_FAILURE_LIMIT=10
#AUTH_CODE_FAILURE_WINDOW_SECONDS=900
# 쿠키로 승인되는 상태 변경 요청(로그인 · 조치 실행 · 종료 등)과 WebSocket 연결을 허용할 Origin(콤마 구분, 정확히 일치, * 금지).
# 비우면 CORS_ALLOW_ORIGINS와 같은 목록.
#AUTH_ALLOWED_ORIGINS=http://localhost:3000
# 열린 WebSocket의 세션 재확인 주기(초). 로그아웃 · 재로그인 회수 · 사용자 비활성이 열린 연결에 반영되는 지연의 상한이다.
# 유휴 · 최대 수명 만료 시각에는 주기와 관계없이 다시 확인한다. 재확인은 유휴 시간을 늘리지 않는다.
#WS_SESSION_CHECK_SECONDS=30

# ── Collector / Scheduler ─────────────────────────
# CloudWatch 메트릭 조회 기간(일) / 집계 주기(초)
METRIC_LOOKBACK_DAYS=14
METRIC_PERIOD_SECONDS=3600
# APScheduler 스캔 주기(초). METRIC_PERIOD_SECONDS 보다 짧아도 된다 — 인벤토리(SG 전체개방 등)는
# 빨리 봐야 하고, 메트릭은 입자 안에서 이미 받아 둔 요약을 재사용한다(#255).
SCAN_INTERVAL_SECONDS=300
# 수집 범위 VPC(콤마 구분 포함 목록). 비우면 리전 전체를 수집한다(기본).
# 단일 계정에 플랫폼 자신(ECS·RDS·ALB VPC)을 함께 배포할 때 관제 대상 VPC만 적어 계정 경계를 흉내 낸다 —
# 플랫폼 자원이 수집·판정되지 않게 한다. Post-MVP SaaS는 관제 범위 = 고객 계정이라 불필요.
# 적힌 VPC가 설정 리전 어디에도 없으면(오타) 그 회차는 소멸 표시를 건너뛰고 PARTIAL로 마감한다(error_summary의 vpc_scope).
#COLLECT_VPC_IDS=vpc-0123456789abcdef0

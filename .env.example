# Vigilantis MVP 환경변수 예시 — 복사해서 .env 로 사용 (cp .env.example .env)
# 실제 .env 는 커밋 금지 (.gitignore 처리됨)

# ── Database (PostgreSQL) ─────────────────────────
POSTGRES_USER=vigilantis
POSTGRES_PASSWORD=vigilantis
POSTGRES_DB=vigilantis
# db 서비스의 호스트 노출 포트. 로컬에 PostgreSQL이 설치돼 5432가 충돌할 때만 변경한다.
# 호스트에서 도는 pytest도 이 값을 읽으므로(apps/core-api/**/tests/conftest.py) 여기만 고치면 된다.
POSTGRES_PORT=5432
# 컨테이너 내부 접속 문자열 — compose 네트워크 안에서는 항상 db:5432라 POSTGRES_PORT와 무관하다.
DATABASE_URL=postgresql+psycopg://vigilantis:vigilantis@db:5432/vigilantis

# ── App ───────────────────────────────────────────
APP_PORT=8000
# Core API 로깅 레벨·CORS 허용 출처(콤마 구분) — 기본값과 다르게 쓸 때만 주석 해제
#LOG_LEVEL=INFO
#CORS_ALLOW_ORIGINS=http://localhost:3000

# ── 실행 디스패치·2/2 Status Check 판정 ────────────
# 기본값과 다르게 쓸 때만 주석 해제. 시연에서 대기를 조여야 하는 값이라 코드 상수가 아니다.
# 스캔 주기(초) — 승인부터 AWS 호출까지의 지연 상한 (apps/core-api/dispatcher.py, #232)
#DISPATCH_INTERVAL_SECONDS=10
# 스캔 잡 기동 스위치. false면 예약이 실행으로 넘어가지 않는다
#DISPATCH_ENABLED=true
# 2/2 Status Check 대기 = Delay × MaxAttempts (기본 15×12 = 3분, #240).
# 판정 1건이 그만큼 다음 스캔을 미룬다(max_instances=1) — 짧게 잡으면 부팅 중인
# 인스턴스가 타임아웃으로 읽혀 자동 원복이 앞당겨 발동한다.
#STATUS_CHECK_WAIT_DELAY_SECONDS=15
#STATUS_CHECK_WAIT_MAX_ATTEMPTS=12

# ── 개발 도구 (선택 — docker compose --profile tools) ──
# adminer(DB 웹 UI) 포트. 8080 충돌 시에만 변경(미설정 시 기본 8080)
ADMINER_PORT=8080

# ── OpenAI (GPT-4o) ───────────────────────────────
OPENAI_API_KEY=sk-...
# 모델 호출 경계(apps/core-api/ai/openai_client.py) 설정 — 기본값과 다르게 쓸 때만 주석 해제
#OPENAI_MODEL=gpt-4o
# 모델 동작 노브 — 값을 넣은 것만 호출에 실린다. 모델 계열마다 받는 것이 다르다:
# gpt-4o는 temperature만, gpt-5 계열 추론 모델은 reasoning_effort만 받는다.
# 받지 않는 쪽을 켜면 호출이 400으로 거절된다(재시도 없이 즉시 실패).
#OPENAI_TEMPERATURE=0
# 값 집합: none | minimal | low | medium | high | xhigh | max (SDK 기준)
# 실제로 받는 값은 모델마다 다르다 — 계측한 gpt-5.6-luna·terra·gpt-5.4-nano는
# none·low·medium·high·xhigh만 받고 minimal·max는 400으로 거절했다(#237).
#OPENAI_REASONING_EFFORT=low
#OPENAI_TIMEOUT_SECONDS=30
# 재시도는 일시 오류만 대상. 1이면 재시도 없음
#OPENAI_MAX_ATTEMPTS=3
#OPENAI_RETRY_BACKOFF_SECONDS=1
# 서버가 Retry-After로 더 길게 지시하면 따르지 않고 backoff로 간다
#OPENAI_MAX_RETRY_AFTER_SECONDS=60

# ── AWS (단일 계정 / 1~2개 리전, MVP) ─────────────
# 개발 표준 = LocalStack (ADR-0006). 더미 자격증명(test)이면 충분하다.
# 실 AWS 전환(6~7주차 스모크·발표 직전): 실제 자격증명으로 교체 + AWS_ENDPOINT_URL 줄 삭제.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-northeast-2
# 복수 리전 수집 시 콤마 구분 (미설정 시 AWS_REGION 사용)
#AWS_REGIONS=ap-northeast-2,us-east-1
# LocalStack 전환 스위치 — 설정 시 LocalStack, 미설정 시 실 AWS (ADR-0006 §3: 이 변수 하나로만 전환)
# 값은 compose 내부(api 컨테이너) 기준. 호스트에서 직접 실행(pytest·시드 스크립트)할 땐 http://localhost:4566 사용.
AWS_ENDPOINT_URL=http://localstack:4566

# ── Collector / Scheduler ─────────────────────────
# CloudWatch 메트릭 조회 기간(일) / 집계 주기(초)
METRIC_LOOKBACK_DAYS=14
METRIC_PERIOD_SECONDS=3600
# APScheduler 스캔 주기(초)
SCAN_INTERVAL_SECONDS=300
